{
  "name": "drydock-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Rate-limited, HMAC-authenticated proxy in front of the steamtools.app API for the Drydock app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "sign": "node scripts/sign.mjs",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "jszip": "^3.10.1",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
