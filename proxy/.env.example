# Copy to .env and fill in. NEVER commit the real .env.

# --- Secrets (required) ---
# DepotBox API key — the upstream for the gamelist, per-app Lua, and game fixes. Stays
# server-side; clients never see it.
DEPOTBOX_API_KEY=your_depotbox_api_key

# The steamtools.app API key, used for the on-demand /v1/app-info enrichment and (when enabled) as
# a depot-package source.
STEAMTOOLS_API_KEY=stpriv_your_real_key

# Ryu (generator.ryuu.lol) reseller auth code — the default depot-package source. Sent as a query
# parameter to secure_download. Required whenever "ryu" is in DEPOT_PACKAGE_SOURCES.
RYU_AUTH_CODE=your_ryu_auth_code

# Shared HMAC secret embedded in the Drydock app at publish time. Generate a long random
# value, e.g.:  openssl rand -hex 32
# Comma-separate to accept multiple secrets during a rotation (old build + new build).
DRYDOCK_HMAC_SECRET=replace_with_openssl_rand_hex_32

# Read-only GitHub PAT for the private MFB repo. The proxy pulls the per-app fixes, repacks and
# Ubisoft magicfiles from GitHub so clients no longer need this token embedded.
GITHUB_TOKEN=github_pat_your_readonly_mfb_token

# --- Optional tuning (defaults shown) ---
# DEPOTBOX_BASE=https://depotbox.org
# STEAMTOOLS_API_BASE=https://api.steamtools.app
# Steam Web API key for /v1/app-schema (emulator-template achievements). Optional — unset returns [].
# STEAM_WEB_API_KEY=
# How long user-facing upstream files (depot packages, fix archives, magicfiles) are cached on disk
# to reduce upstream API load. Default 86400 (24h). Entries are swept hourly once they are twice this
# old, so the cache directory stays bounded — plan disk for roughly a day or two of distinct downloads.
# FILE_CACHE_TTL_SECONDS=86400
# RYU_API_BASE=https://generator.ryuu.lol
# Depot-package upstreams (ordered, first match wins). Default "ryu"; use all three with
# "ryu,depotbox,steamtools". Unknown names are ignored.
# DEPOT_PACKAGE_SOURCES=ryu
# HOST=0.0.0.0
# PORT=8080
# TRUST_PROXY=true

# Refresh the cached gamelist this often (minutes).
# GAMELIST_REFRESH_MINUTES=60
# Drop entries that carry an NSFW tag when building the catalog (true/false).
# FILTER_NSFW=true

# --- GitHub payload (per-app fixes, repacks, magicfiles) via the Contents API ---
# GITHUB_OWNER=NhMarco
# GITHUB_REPO=MFB
# GITHUB_BRANCH=main
# Repo directory of the per-app fixes ({appid}.lua + {appid}.zip[.NNN]).
# FIX_DIRECTORY=Files/fix
# How long to cache the fixes manifest (seconds); file bytes are always pulled fresh.
# FIXES_MANIFEST_TTL_SECONDS=300
# Repo file listing per-app repacks ({ "<appid>": [{ repacker, link }] }); non-http(s) links dropped.
# REPACKS_PATH=Files/repacks.json
# How long to cache the repacks list (seconds).
# REPACKS_TTL_SECONDS=300

# Per-client (per-IP) limit on lua generation.
# LUA_RATE_MAX=1
# LUA_RATE_WINDOW_SECONDS=60

# Server-side lua cache TTL to shield upstream from popular titles (seconds; 0 disables).
# LUA_CACHE_TTL_SECONDS=900
# Server-side per-app app-info cache TTL (seconds; 0 disables).
# APP_INFO_CACHE_TTL_SECONDS=86400

# Global per-IP safety limiter across all endpoints.
# GLOBAL_RATE_MAX=120
# GLOBAL_RATE_WINDOW_SECONDS=60

# Allowed clock skew for signed requests (seconds).
# HMAC_WINDOW_SECONDS=60

# Set to false ONLY for local testing to disable HMAC verification entirely.
# REQUIRE_AUTH=true
